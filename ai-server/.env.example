# ── AI Provider ──────────────────────────────────────────────────────────────
# Works with any OpenAI-compatible API (Groq, OpenRouter, OpenAI, etc.)

# Your API key from the provider
AI_API_KEY=your-api-key-here

# Provider base URL — leave blank for OpenAI default
# Groq:       https://api.groq.com/openai/v1
# OpenRouter:  https://openrouter.ai/api/v1
# Ollama:      http://localhost:11434/v1
AI_BASE_URL=

# Model name for the chosen provider
# Groq:        llama-3.3-70b-versatile
# OpenAI:      gpt-4o-mini
# OpenRouter:  anthropic/claude-sonnet-4-6
AI_MODEL=llama-3.3-70b-versatile

# ── License keys (comma-separated) ───────────────────────────────────────────
VALID_LICENSE_KEYS=test-key-123,your-real-key-here
